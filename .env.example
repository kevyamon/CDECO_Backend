# ==============================================================================
# CONFIGURATION SERVEUR CDECO BACKEND
# ==============================================================================

# Port d'écoute du serveur
PORT=5000

# Environnement (development / production)
NODE_ENV=development

# Origine autorisée pour le Frontend (CORS) - Utilisé sur Render ou en local
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Connexion MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cdeco?retryWrites=true&w=majority

# Sécurité & Tokens JWT
JWT_SECRET=votre_cle_secrete_jwt_ultra_robuste_a_remplacer
JWT_REFRESH_SECRET=votre_cle_secrete_refresh_ultra_robuste_a_remplacer
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Identifiants du Super-Administrateur (créé automatiquement au démarrage)
AD_ID=admin@cdeco.org
AD_PW=AdminCdeco2026!Securise

# Configuration Cloudinary (Gestion des médias & images)
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

